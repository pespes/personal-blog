---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

{SHARE_LINKS.length > 0 && (
  <div class="flex flex-none flex-col items-center justify-center gap-1 lg:items-start">
    <span class="type-body-sm text-muted">Share this post on:</span>
    <div class="text-center">
      {SHARE_LINKS.map(social => (
        <LinkButton
          href={`${social.href + URL}`}
          class="scale-90 p-2 text-muted transition-colors hover:rotate-6 hover:text-foreground lg:p-1"
          title={social.linkTitle}
        >
          <social.icon class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 group-hover:fill-transparent lg:scale-110" />
          <span class="sr-only">{social.linkTitle}</span>
        </LinkButton>
      ))}
    </div>
  </div>
)}

---
import type { HTMLAttributes } from "astro/types";

interface MenuItem {
  label: string;
  href: string;
  /** Renders the link as the current page (persistent underline). */
  active?: boolean;
}

type Props = {
  /** Left-aligned navigation links. */
  items?: MenuItem[];
  /** Trailing call-to-action pill. Pass `null` to omit. */
  cta?: { label: string; href: string } | null;
} & HTMLAttributes<"nav">;

const {
  items = [
    { label: "Home", href: "/" },
    { label: "Work", href: "#" },
    { label: "Blog", href: "#" },
    { label: "Resume", href: "#" },
  ],
  cta = { label: "Email me", href: "#" },
  class: className,
  "aria-label": ariaLabel = "Primary",
  ...attrs
} = Astro.props;
---

<nav
  aria-label={ariaLabel}
  class:list={[
    "inline-flex items-center gap-2.5 rounded-full py-2 pr-2 pl-4",
    "border border-border shadow-[0_2px_4px_rgb(0_0_0/0.16)]",
    // Theme-aware "glass": blur the backdrop where supported, fall back to a
    // more opaque panel where it isn't.
    "bg-background/90 backdrop-blur-md supports-[backdrop-filter]:bg-background/70",
    className,
  ]}
  {...attrs}
>
  <ul class="flex items-center gap-2.5">
    {items.map(item => (
      <li>
        <a
          href={item.href}
          aria-current={item.active ? "page" : undefined}
          class:list={[
            "block rounded-md px-2 py-2 text-base font-medium underline-offset-4 hover:underline",
            { underline: item.active },
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
  {cta && (
    <a
      href={cta.href}
      class="rounded-full bg-accent px-5 py-2 text-base font-medium text-background transition-colors hover:bg-accent/90"
    >
      {cta.label}
    </a>
  )}
</nav>

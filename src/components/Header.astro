---
import { MoonIcon, SunIcon, MenuIcon } from "@lucide/astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { primaryButtonClass } from "@/utils/buttonClasses";

const mailHref = SOCIALS.find(s => s.name === "Mail")?.href ?? "#";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Site sections. Work also owns the case studies under /work; Writing owns
// the post pages under /posts.
const navItems = [
  {
    label: "Work",
    href: "/",
    active: currentPath === "/" || isActive("/work"),
  },
  {
    label: "Writing",
    href: "/writing",
    active: isActive("/writing") || isActive("/posts"),
  },
  { label: "About", href: "/about", active: isActive("/about") },
];

// Round 40px icon button (hamburger, theme toggle).
const iconButtonClass =
  "relative inline-flex size-10 items-center justify-center rounded-3xl text-default-foreground hover:bg-default-hover active:scale-[0.97]";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-link underline underline-offset-4 backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header class="w-full border-b border-border">
  <div class="container-content flex items-center justify-between py-6 lg:py-8">
    <a href="/" class="type-h4 whitespace-nowrap">
      {SITE.title}
    </a>

    {/* Desktop nav (lg+) */}
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class="type-display-body-sm uppercase hover-underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {/* Theme toggle — placement is an open decision (docs/design.md). */}
      {SITE.lightAndDarkMode && (
        <button
          id="theme-btn"
          class={iconButtonClass}
          title="Toggles light & dark"
          aria-label="auto"
          aria-live="polite"
        >
          <MoonIcon class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <SunIcon class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )}

      <a
        href={mailHref}
        class:list={["hidden lg:inline-flex", primaryButtonClass]}
      >
        Send an email
      </a>

      {/* Mobile / tablet: hamburger + dropdown (below lg) */}
      <div class="relative lg:hidden">
        <button
          id="menu-btn"
          class:list={[iconButtonClass, "aria-expanded:bg-default-hover"]}
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <MenuIcon class="size-6" />
        </button>

        {/* HeroUI Dropdown */}
        <nav
          id="menu-items"
          aria-label="Primary"
          hidden
          class="absolute end-0 top-full z-50 mt-2 flex w-60 flex-col gap-1 rounded-3xl bg-overlay p-2 text-overlay-foreground shadow-overlay"
        >
          <ul class="flex flex-col gap-1">
            {navItems.map(item => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? "page" : undefined}
                  class="flex min-h-9 items-center rounded-2_5xl px-3 py-1.5 type-display-body-sm text-default-foreground uppercase outline-none hover:bg-default focus-visible:bg-default"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <a href={mailHref} class:list={["flex w-full", primaryButtonClass]}>
            Send an email
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  function initMenu() {
    // Re-run after view transitions swap the header in; drop old listeners.
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector<HTMLElement>("#menu-items");
    if (!menuBtn || !menu) return;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    menuBtn.addEventListener("click", () => setOpen(menu.hidden), { signal });

    document.addEventListener(
      "keydown",
      e => {
        if (e.key === "Escape" && !menu.hidden) {
          setOpen(false);
          menuBtn.focus();
        }
      },
      { signal }
    );

    document.addEventListener(
      "click",
      e => {
        const target = e.target as Node;
        if (!menu.hidden && !menu.contains(target) && !menuBtn.contains(target))
          setOpen(false);
      },
      { signal }
    );
  }

  initMenu();
  document.addEventListener("astro:after-swap", initMenu);
</script>

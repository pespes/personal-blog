---
import {
  XIcon,
  MoonIcon,
  SearchIcon,
  ArchiveIcon,
  SunIcon,
  MenuIcon,
} from "@lucide/astro";
import LinkButton from "./LinkButton.astro";
import Menu from "./Menu.astro";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const mailHref = SOCIALS.find(s => s.name === "Mail")?.href ?? "#";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-baseline justify-between sm:items-center",
    ]}
  >
    <a
      href="/"
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full items-center justify-end gap-x-2 sm:ms-2 sm:gap-x-3"
    >
      {/* Desktop: pill menu (from the Figma "Menu" component) */}
      <div class="hidden sm:block">
        <Menu
          aria-label="Primary"
          items={[
            { label: "Home", href: "/", active: currentPath === "/" },
            { label: "Posts", href: "/posts", active: isActive("/posts") },
            { label: "Tags", href: "/tags", active: isActive("/tags") },
            { label: "About", href: "/about", active: isActive("/about") },
          ]}
          cta={{ label: "Email me", href: mailHref }}
        />
      </div>

      {/* Mobile: hamburger toggle */}
      <button
        id="menu-btn"
        class="focus-outline p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <XIcon id="close-icon" class="hidden" />
        <MenuIcon id="menu-icon" />
      </button>

      {/* Mobile: collapsible link list (toggled by #menu-btn) */}
      <ul
        id="menu-items"
        class:list={[
          "absolute end-0 top-full z-20 mt-2 hidden w-48 flex-col gap-1",
          "rounded-md border border-border bg-background p-2 shadow-lg",
          "[&>li>a]:block [&>li>a]:rounded [&>li>a]:px-3 [&>li>a]:py-2 [&>li>a]:font-medium [&>li>a]:hover:text-accent",
          "sm:hidden",
        ]}
      >
        <li>
          <a href="/" class:list={{ "active-nav": currentPath === "/" }}>Home</a
          >
        </li>
        <li>
          <a href="/posts" class:list={{ "active-nav": isActive("/posts") }}>
            Posts
          </a>
        </li>
        <li>
          <a href="/tags" class:list={{ "active-nav": isActive("/tags") }}
            >Tags</a
          >
        </li>
        <li>
          <a href="/about" class:list={{ "active-nav": isActive("/about") }}>
            About
          </a>
        </li>
        <li>
          <a href={mailHref}>Email me</a>
        </li>
      </ul>

      {/* Always-visible controls */}
      <div class="flex items-center gap-x-1 sm:gap-x-2">
        {
          SITE.showArchives && (
            <LinkButton
              href="/archives"
              class:list={[
                "focus-outline flex justify-center p-2 sm:p-1",
                { "active-nav [&>svg]:stroke-accent": isActive("/archives") },
              ]}
              title="Archives"
              aria-label="archives"
            >
              <ArchiveIcon />
              <span class="sr-only">Archives</span>
            </LinkButton>
          )
        }
        <LinkButton
          href="/search"
          class:list={[
            "focus-outline flex p-2 sm:p-1",
            { "[&>svg]:stroke-accent": isActive("/search") },
          ]}
          title="Search"
          aria-label="search"
        >
          <SearchIcon />
          <span class="sr-only">Search</span>
        </LinkButton>
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative size-10 p-3 sm:size-8 sm:p-2 hover:[&>svg]:stroke-accent"
              title="Toggles light & dark"
              aria-label="auto"
              aria-live="polite"
            >
              <MoonIcon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <SunIcon class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>

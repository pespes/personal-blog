---
// Password gate for a case study. At build time the slot's HTML (between the
// markers) is replaced with ciphertext by src/integrations/protectCaseStudies.ts;
// the script below decrypts it in the browser. In `pnpm dev` nothing is
// encrypted, so the content is shown straight away.
import { LockIcon } from "@lucide/astro";
import { primaryButtonClass } from "@/utils/buttonClasses";
import { PROTECTED_END, PROTECTED_START } from "@/utils/protectedContent";
---

<div data-protected>
  <form
    data-protected-form
    data-pagefind-ignore
    class="flex flex-col gap-4 rounded-3xl bg-surface p-6 text-surface-foreground shadow-surface"
  >
    <div class="flex items-center gap-2">
      <LockIcon class="size-5" aria-hidden="true" />
      <h2 class="type-h5">This case study is password protected</h2>
    </div>
    <p class="type-body-sm text-muted">
      Enter the password you were given to read it.
    </p>
    <div class="flex flex-col gap-1.5">
      <label for="protected-password" class="type-body-sm-medium">
        Password
      </label>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input
          id="protected-password"
          type="password"
          required
          autocomplete="current-password"
          aria-describedby="protected-error"
          class="h-9 w-full rounded-field bg-field px-3 type-field-sm text-field-foreground shadow-field focus-ring-field placeholder:text-field-placeholder hover:bg-field-hover focus:bg-field-focus"
        />
        <button type="submit" class:list={["inline-flex", primaryButtonClass]}>
          Unlock
        </button>
      </div>
      <p
        id="protected-error"
        role="alert"
        hidden
        class="type-body-xs text-danger-soft-foreground"
      >
        That password didn't work. Try again.
      </p>
    </div>
  </form>

  <div data-protected-body hidden>
    <Fragment set:html={PROTECTED_START} />
    <slot />
    <Fragment set:html={PROTECTED_END} />
  </div>
</div>

<script>
  const STORAGE_KEY = "work-password";

  const fromBase64 = (b64: string) =>
    Uint8Array.from(atob(b64), c => c.charCodeAt(0));

  async function decrypt(
    payload: string,
    iterations: number,
    password: string
  ) {
    const [salt, iv, data] = payload.split(".").map(fromBase64);
    const baseKey = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(password),
      "PBKDF2",
      false,
      ["deriveKey"]
    );
    const key = await crypto.subtle.deriveKey(
      { name: "PBKDF2", salt, iterations, hash: "SHA-256" },
      baseKey,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"]
    );
    const plaintext = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv },
      key,
      data
    );
    return new TextDecoder().decode(plaintext);
  }

  const storage = {
    get: () => {
      try {
        return sessionStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    },
    set: (value: string | null) => {
      try {
        if (value === null) sessionStorage.removeItem(STORAGE_KEY);
        else sessionStorage.setItem(STORAGE_KEY, value);
      } catch {
        // Storage unavailable (private mode, blocked): unlock just won't persist.
      }
    },
  };

  function init() {
    const root = document.querySelector<HTMLElement>("[data-protected]");
    if (!root) return;

    const form = root.querySelector<HTMLFormElement>("[data-protected-form]")!;
    const body = root.querySelector<HTMLElement>("[data-protected-body]")!;
    const cipher = body.querySelector<HTMLElement>("[data-protected-cipher]");
    const input = form.querySelector<HTMLInputElement>("input")!;
    const error = form.querySelector<HTMLElement>("#protected-error")!;

    const reveal = () => {
      form.hidden = true;
      body.hidden = false;
    };

    // Dev server: the build step hasn't run, so the content is plain HTML.
    if (!cipher) return reveal();

    const payload = cipher.dataset.protectedCipher!;
    const iterations = Number(cipher.dataset.iterations);

    const unlock = async (password: string) => {
      try {
        body.innerHTML = await decrypt(payload, iterations, password);
        storage.set(password);
        reveal();
        return true;
      } catch {
        return false;
      }
    };

    const saved = storage.get();
    if (saved) {
      unlock(saved).then(ok => {
        if (!ok) storage.set(null); // password changed since it was saved
      });
    }

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (await unlock(input.value)) return;
      error.hidden = false;
      input.setAttribute("aria-invalid", "true");
      input.select();
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
